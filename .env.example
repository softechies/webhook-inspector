# Copy to .env.local and change what you need.

# Where the SQLite file is kept.
DATABASE_PATH=./data/inspector.db

# Older requests are dropped once a URL has this many.
MAX_REQUESTS_PER_BIN=500

# Bodies larger than this are cut (the real size is still shown). 1 MB.
MAX_BODY_BYTES=1048576

# Turns on a password for the inspector pages and API. Webhook URLs (/h/...) stay open.
# Any username works in the browser prompt.
INSPECTOR_PASSWORD=

# The address senders use to reach you, e.g. https://hooks.example.com
# Leave empty to work it out from the request (fine behind most proxies).
PUBLIC_URL=
